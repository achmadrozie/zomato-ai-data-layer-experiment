dbt_zomato_layer_refactor:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('DBT_SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('DBT_SNOWFLAKE_USER') }}"
      password: "{{ env_var('DBT_ENV_SECRET_SNOWFLAKE_PASSWORD') }}"
      role: DBT_LAYER_REFACTOR_ROLE
      warehouse: ZOMATO_WH
      database: ZOMATO_LAYER_REFACTOR
      schema: STAGING
      threads: 8
