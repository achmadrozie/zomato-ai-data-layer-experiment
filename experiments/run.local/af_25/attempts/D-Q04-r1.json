        "kind": "sql",
        "query": "SELECT ORDER_DATE, \n       COUNT(CASE WHEN IS_CANCELLED THEN 1 END) AS CANCELLED_ORDER_COUNT,\n       COUNT(*) AS TOTAL_ORDER_COUNT,\n       100.0 * COUNT(CASE WHEN IS_CANCELLED THEN 1 END) / NULLIF(COUNT(*),0) AS CANCELLATION_RATE_PERCENT\nFROM ZOMATO_DLR.CORE.FACT_ORDER\nWHERE ORDER_DATE >= '2025-01-01' AND ORDER_DATE < '2026-01-01'\nGROUP BY ORDER_DATE\nORDER BY ORDER_DATE\nLIMIT 40;",
