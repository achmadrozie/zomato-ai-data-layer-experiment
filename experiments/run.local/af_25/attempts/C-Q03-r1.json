      "action": {
        "kind": "sql",
        "query": "SELECT ORDER_DATE, ROUND(SUM(SALES_AMOUNT) / NULLIF(COUNT(DISTINCT ORDER_ID), 0), 6) AS AOV_INR\nFROM ZOMATO_DLR.CORE.FACT_ORDER\nWHERE ORDER_DATE >= '2025-01-01' AND ORDER_DATE < '2026-01-01'\n  AND CURRENCY = 'INR'\nGROUP BY ORDER_DATE\nORDER BY ORDER_DATE\nLIMIT 40;",
