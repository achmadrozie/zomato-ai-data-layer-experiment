      "action": {
        "kind": "sql",
        "query": "SELECT \n  ob.ORDER_DATE,\n  COUNT(CASE WHEN ofl.IS_CANCELLED = TRUE THEN 1 END) AS cancelled_orders,\n  COUNT(*) AS total_orders,\n  100.0 * COUNT(CASE WHEN ofl.IS_CANCELLED = TRUE THEN 1 END) / COUNT(*) AS cancellation_rate_percent\nFROM ZOMATO_DLR.INTERMEDIATE.INT_ORDER_BASE ob\nJOIN ZOMATO_DLR.INTERMEDIATE.INT_ORDER_FULFILLMENT ofl ON ob.ORDER_ID = ofl.ORDER_ID\nWHERE ob.ORDER_DATE >= '2025-01-01' AND ob.ORDER_DATE < '2026-01-01'\nGROUP BY ob.ORDER_DATE\nORDER BY ob.ORDER_DATE\nLIMIT 40;",
        "metrics": "cancellation rate as a percentage, cancelled orders, total orders",
