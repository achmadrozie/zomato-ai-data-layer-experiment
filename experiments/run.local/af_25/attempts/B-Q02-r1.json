        "kind": "sql",
        "query": "SELECT ORDER_DATE, SUM(SALES_AMOUNT) AS GMV_INR\nFROM ZOMATO_DLR.INTERMEDIATE.INT_ORDER_BASE ob\nJOIN ZOMATO_DLR.INTERMEDIATE.INT_ORDER_FINANCIALS ofin ON ob.ORDER_ID = ofin.ORDER_ID\nWHERE ob.ORDER_DATE >= '2025-01-01' AND ob.ORDER_DATE < '2026-01-01'\n  AND ob.CURRENCY = 'INR'\nGROUP BY ORDER_DATE\nORDER BY ORDER_DATE\nLIMIT 40;",
