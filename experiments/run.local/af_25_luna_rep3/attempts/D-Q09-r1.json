    {
      "action": {
        "kind": "sql",
        "query": "WITH city_rates AS (\n  SELECT CITY,\n         COUNT(*) AS ORDER_COUNT,\n         SUM(IFF(IS_CANCELLED, 1, 0)) AS CANCELLED_ORDER_COUNT,\n         SUM(IFF(IS_CANCELLED, 1, 0)) / COUNT(*)::FLOAT AS CANCELLATION_RATE\n  FROM ZOMATO_DLR.CORE.FACT_ORDER\n  WHERE ORDER_DATE >= '2025-01-01' AND ORDER_DATE < '2026-01-01'\n    AND CITY IS NOT NULL\n  GROUP BY CITY\n  HAVING COUNT(*) >= 50000\n), overall AS (\n  SELECT SUM(IFF(IS_CANCELLED, 1, 0)) / COUNT(*)::FLOAT AS OVERALL_CANCELLATION_RATE\n  FROM ZOMATO_DLR.CORE.FACT_ORDER\n  WHERE ORDER_DATE >= '2025-01-01' AND ORDER_DATE < '2026-01-01'\n)\nSELECT c.CITY,\n       c.ORDER_COUNT,\n       c.CANCELLED_ORDER_COUNT,\n       c.CANCELLATION_RATE * 100 AS CANCELLATION_RATE_PERCENT,\n       (c.CANCELLATION_RATE - o.OVERALL_CANCELLATION_RATE) * 100 AS GAP_VS_OVERALL_PERCENTAGE_POINTS,\n       o.OVERALL_CANCELLATION_RATE * 100 AS OVERALL_CANCELLATION_RATE_PERCENT\nFROM city_rates c CROSS JOIN overall o\nWHERE c.CANCELLATION_RATE = (SELECT MAX(CANCELLATION_RATE) FROM city_rates)\nORDER BY c.CITY\nLIMIT 40",
        "metrics": "",
        "group_by": "",
